pkgname=3ds-SDL3_gfx
pkgver=2.0.0
pkgrel=1
pkgdesc="SDL3 graphics drawing primitives and other support functions (Nintendo 3DS port)"
arch=('any')
url="https://www.ferzkopp.net/wordpress/2016/01/02/sdl_gfx-sdl2_gfx/"
license=('zlib')
groups=('3ds-portlibs' '3ds-sdl3-libs')
depends=(
    '3ds-SDL3'
)
makedepends=(
    '3ds-pkg-config'
    'cmake'
    'dkp-toolchain-vars'
)
options=(!strip libtool staticlibs)
source=("SDL3_gfx-$pkgver.tar.gz::https://github.com/ferzkopp/SDL3_gfx/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('3e817771b31ca63386514fd35ce00fd5ae20422a54f8980582fd5e3bc93dc68f')

build() {
    source /opt/devkitpro/3dsvars.sh

    arm-none-eabi-cmake \
        -S SDL3_gfx-$pkgver \
        -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -Wno-author
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
