pkgname=3ds-SDL3_image
pkgver=3.4.8
pkgrel=1
pkgdesc="Image decoding for many popular formats for SDL3 (Nintendo 3DS port)"
arch=('any')
url="https://libsdl.org/"
license=('MIT')
groups=('3ds-portlibs' '3ds-sdl3-libs')
depends=(
    '3ds-libjpeg-turbo'
    '3ds-libpng'
    '3ds-SDL3'
)
makedepends=(
    '3ds-pkg-config'
    'cmake'
    'dkp-toolchain-vars'
)
options=(!strip libtool staticlibs)
source=("https://github.com/libsdl-org/SDL_image/releases/download/release-$pkgver/SDL3_image-$pkgver.tar.gz")
sha256sums=('e8223b424bc7541cf84ffff5cf7e4f24ec3711c60462cb1bd6dc1d7bd7f25477')

build() {
    source /opt/devkitpro/3dsvars.sh

    arm-none-eabi-cmake \
        -S SDL3_image-$pkgver \
        -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DSDLIMAGE_BACKEND_STB=OFF \
        -DSDLIMAGE_DEPS_SHARED=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
