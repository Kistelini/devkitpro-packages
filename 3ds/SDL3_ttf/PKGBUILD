pkgname=3ds-SDL3_ttf
pkgver=3.2.2
pkgrel=1
pkgdesc="Support for TrueType (.ttf) font files with SDL3 (Nintendo 3DS port)"
arch=('any')
url="https://libsdl.org/"
license=('MIT')
groups=('3ds-portlibs' '3ds-sdl3-libs')
depends=(
    '3ds-freetype'
    '3ds-SDL3'
)
makedepends=(
    '3ds-pkg-config'
    'cmake'
    'dkp-toolchain-vars'
)
options=(!strip libtool staticlibs)
source=("https://github.com/libsdl-org/SDL_ttf/releases/download/release-$pkgver/SDL3_ttf-$pkgver.tar.gz")
sha256sums=('63547d58d0185c833213885b635a2c0548201cc8f301e6587c0be1a67e1e045d')

build() {
    source /opt/devkitpro/3dsvars.sh

    arm-none-eabi-cmake \
        -S SDL3_ttf-$pkgver \
        -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DSDLTTF_SAMPLES=OFF # link error
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
